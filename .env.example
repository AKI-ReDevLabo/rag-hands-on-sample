# --- Qdrant ---
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=minefield_docs

# --- 埋め込みバックエンド ---
# local  : sentence-transformers（既定・APIキー不要）
# gemini : Vertex AI（GCPプロジェクトとADCが必要）
# dummy  : ハッシュベースのダミー（疎通確認用）
EMBEDDING_BACKEND=local
LOCAL_MODEL_NAME=intfloat/multilingual-e5-small
# auto / cpu / cuda。auto は PyTorch が対応していない GPU なら cpu を使う
LOCAL_DEVICE=auto
LOCAL_VECTOR_SIZE=384

# GCP_PROJECT=
# GCP_LOCATION=asia-northeast1
# GEMINI_VECTOR_SIZE=768

# --- 検索パラメータ ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=300
N_RESULTS=15
RRF_SCORE_THRESHOLD=0.20

# --- 地雷スイッチ（第5章の再現用）---
BUG_SPARSE_UNSTABLE_HASH=0
BUG_MERGE_NO_LIMIT=0
BUG_ORPHAN_CHUNKS=0
BUG_FREE_MODE_ROUTING=0
BUG_CONTRADICTING_RULE=0
BUG_CODE_REGEX_MATCHES_DATE=0
BUG_IGNORE_VALIDITY=0

# --- 回答生成 ---
# ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-4-6
# 200 程度にすると回答が途中で切れる（stop_reason の確認用）
ANSWER_MAX_TOKENS=4096
# 追加質問のときに LLM へ渡す直前のやりとりの数（質問と回答の組）
HISTORY_TURNS=3

# --- リランク（haiku は APIキーがあるときだけ動く）---
# 0 にすると RRF の閾値だけで絞る
RERANK=1
# haiku（APIキーが必要）/ keyword（APIキー不要の簡易版。質問の語が本文にいくつ含まれるか）
RERANK_BACKEND=haiku
RERANK_MODEL=claude-haiku-4-5
RERANK_CANDIDATES=40
RERANK_TOP_K=8
# Haiku の最高スコアがこれ未満なら「見つからない」（nohit）
RERANK_NO_HIT_SCORE=3

# --- 追加質問の書き直し（APIキーがあるときだけ動く）---
# 0 にすると、追加質問も生の質問文のまま検索する
EXPAND_QUERY=1
EXPAND_MODEL=claude-haiku-4-5
EXPAND_HISTORY_MESSAGES=4

# --- 質問ログ（チャットUI）---
# 空にすると記録しない。既定は logs/questions.jsonl
# QUESTION_LOG=

# --- 構造化データ層 ---
# 0 にすると、件数・一覧の質問も RAG だけで答える（事件簿⑤の状態）
STRUCTURED=1

# --- コード指定モード ---
# 0 にすると、管理番号があっても codes で絞り込まない
CODE_SEARCH=1

# --- 適用期間 ---
# 検索の基準日（YYYY-MM-DD）。空なら今日
# AS_OF=
